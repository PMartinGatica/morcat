---
/**
 * MORCAT — /proyectos/[slug]
 * Página individual de proyecto.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import DemoBadge from '../../components/DemoBadge.astro';
import Icon from '../../components/Icon.astro';
import MediaImage from '../../components/MediaImage.astro';
import { PROJECTS } from '../../data/projects';
import { formatMeters, formatPercent } from '../../lib/utils/format';
import type { Crumb } from '../../lib/seo/structuredData';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: (typeof PROJECTS)[number];
}

const { project } = Astro.props;

const crumbs: Crumb[] = [
  { name: 'Inicio', path: '/' },
  { name: 'Proyectos', path: '/proyectos' },
  { name: project.name, path: `/proyectos/${project.slug}` },
];

const features = [
  { label: 'Tipo', value: project.type },
  { label: 'Ubicación', value: project.location },
  { label: 'Estado', value: project.status },
  ...(project.surface != null ? [{ label: 'Superficie', value: formatMeters(project.surface)! }] : []),
  ...(project.completion != null ? [{ label: 'Avance', value: formatPercent(project.completion) }] : []),
];

const otherProjects = PROJECTS.filter((p) => p.id !== project.id).slice(0, 3);
const statusDesc =
  project.status === 'En obra'
    ? 'Proyecto en ejecución. Se publicarán fotos de avance de obra cuando estén disponibles.'
    : project.status === 'Finalizado'
      ? 'Obra terminada y entregada.'
      : 'Proyecto en etapa de definición y presupuesto.';
---

<BaseLayout
  title={`${project.name} · ${project.type} en ${project.location} — MORCAT`}
  description={project.description.slice(0, 155)}
  canonicalPath={`/proyectos/${project.slug}`}
  breadcrumbs={crumbs}
>
  <!-- HERO -->
  <section class="relative flex min-h-[75svh] items-end overflow-hidden bg-navy-950 pt-36">
    <div class="absolute inset-0">
      <MediaImage
        src={project.gallery[0] ?? 'front'}
        alt={`${project.name} — ${project.location}`}
        class="h-full w-full object-cover"
        eager
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/55 to-navy-950/35" aria-hidden="true" />

    <div class="wrap relative z-10 pb-16">
      <div class="flex flex-wrap items-center gap-3 intro-item" style="animation-delay: .1s">
        <DemoBadge demo={project.demo} />
        <span class="chip !border-gold-500/40 !bg-navy-950/70 !py-1 !text-[10px] uppercase tracking-[0.2em] text-gold-400">
          {project.status}
        </span>
        <span class="flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-mist-400">
          <Icon name="map-pin" class="h-3.5 w-3.5" />
          {project.location}
        </span>
      </div>

      <h1 class="display-xl mt-5 text-warm-50 intro-item" style="animation-delay: .2s">
        {project.name}
      </h1>

      <p class="mt-4 text-[15px] text-mist-300 intro-item" style="animation-delay: .3s">
        {project.type} · {statusDesc}
      </p>
    </div>
  </section>

  <!-- DESCRIPCIÓN + CARACTERÍSTICAS -->
  <section class="relative bg-navy-900 py-20 sm:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div data-reveal>
        <div class="eyebrow">
          <span>Sobre el proyecto</span>
        </div>
        <h2 class="display mt-5 text-3xl text-warm-50">
          El <span class="serif-accent text-gold-500">proyecto.</span>
        </h2>
        <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-mist-300 sm:text-base">
          {project.description}
        </p>
        <p class="mt-4 text-[13px] text-mist-500">
          La información de este proyecto es de referencia inicial y puede actualizarse.
        </p>
      </div>

      <aside class="border border-warm-50/12 bg-navy-800/60 p-7" data-reveal>
        <h3 class="display text-lg text-warm-50">Ficha técnica</h3>
        <dl class="mt-6 space-y-4">
          {features.map((f) => (
            <div class="flex items-baseline justify-between gap-6 border-b border-warm-50/10 pb-3">
              <dt class="text-[11px] font-semibold uppercase tracking-[0.2em] text-mist-400">{f.label}</dt>
              <dd class="text-right text-[15px] font-semibold text-warm-50">{f.value}</dd>
            </div>
          ))}
        </dl>

        {project.status === 'En obra' && project.completion != null && (
          <div class="mt-7">
            <div class="flex items-center justify-between text-[11px] uppercase tracking-[0.2em] text-warm-100">
              <span>Avance de obra</span>
              <span class="text-gold-400">{formatPercent(project.completion)}</span>
            </div>
            <div class="mt-2 h-px w-full bg-warm-50/20" aria-hidden="true">
              <div class="h-full bg-gold-500" style={`width: ${project.completion}%`} />
            </div>
          </div>
        )}

        <div class="mt-7 space-y-3">
          <a href="/contacto" class="btn btn-gold w-full">
            Consultar por este proyecto
            <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
          <a href="/proyectos" class="btn btn-ghost w-full">Volver a proyectos</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- GALERÍA -->
  {project.gallery.length > 1 && (
    <section class="bg-navy-950 py-20 sm:py-24">
      <div class="wrap">
        <div class="flex items-end justify-between gap-6">
          <div data-reveal>
            <div class="eyebrow">
              <span>Galería</span>
            </div>
            <h2 class="display mt-4 text-2xl text-warm-50 sm:text-3xl">Imágenes del proyecto</h2>
          </div>
          <DemoBadge demo={project.demo} label="IMÁGENES DEMO" class="mb-1" />
        </div>
        <div class="mt-10">
          <ProjectGallery images={project.gallery} altPrefix={project.name} />
        </div>
      </div>
    </section>
  )}

  <!-- OTROS PROYECTOS -->
  {otherProjects.length > 0 && (
    <section class="border-t border-warm-50/10 bg-navy-900 py-20">
      <div class="wrap">
        <h2 class="display text-2xl text-warm-50" data-reveal>
          Otros <span class="serif-accent text-gold-500">proyectos.</span>
        </h2>
        <div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {otherProjects.map((p, i) => (
            <a
              href={`/proyectos/${p.slug}`}
              class="group flex items-center gap-5 border border-warm-50/12 bg-navy-800/50 p-5 transition-colors duration-300 hover:border-gold-500/50"
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <span class="display shrink-0 text-lg text-gold-500">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="block text-[11px] uppercase tracking-[0.2em] text-mist-400">{p.type}</span>
                <span class="display mt-1 block text-base text-warm-50 group-hover:text-gold-300">{p.name}</span>
              </span>
              <Icon name="arrow-up-right" class="ml-auto h-5 w-5 shrink-0 text-gold-500/60" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
