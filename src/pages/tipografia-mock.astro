---
/**
 * MORCAT — Mockup interno de tipografía (temporal).
 *
 * Página de comparación para que Rodrigo elija variante de fuente.
 * No es contenido final del sitio: noindex, no aparece en el sitemap
 * ni en ningún menú. Borrar cuando se decida la tipografía definitiva.
 *
 * Grupo 1 — script/manuscrita para el nombre "Morcat" (pedido en la
 * reunión: "Brush Script", ni muy pegada ni muy abierta).
 * Grupo 2 — condensada/industrial para titulares, como alternativa
 * gratuita a Haettenschweiler (fuente comercial de Monotype, no apta
 * para incrustar en una web pública sin licencia).
 */
import '@fontsource/sacramento';
import '@fontsource/yellowtail';
import '@fontsource/kaushan-script';
import '@fontsource-variable/caveat';
import '@fontsource/anton';
import '@fontsource/bebas-neue';
import '@fontsource-variable/oswald';

const scriptFonts = [
  {
    name: 'Sacramento',
    family: "'Sacramento', cursive",
    tag: 'Muy pegada / fina',
  },
  {
    name: 'Yellowtail',
    family: "'Yellowtail', cursive",
    tag: 'La más parecida a Brush Script clásica',
  },
  {
    name: 'Kaushan Script',
    family: "'Kaushan Script', cursive",
    tag: 'Pegada / trazo grueso',
  },
  {
    name: 'Caveat',
    family: "'Caveat Variable', cursive",
    tag: 'Abierta / manuscrita',
  },
];

const condensedFonts = [
  { name: 'Anton', family: "'Anton', sans-serif", tag: 'La más parecida a Haettenschweiler' },
  { name: 'Bebas Neue', family: "'Bebas Neue', sans-serif", tag: 'Más angosta y liviana' },
  { name: 'Oswald 700', family: "'Oswald Variable', sans-serif", weight: 700, tag: 'Condensada más legible' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MORCAT — Mockup de tipografía</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      body {
        margin: 0;
        background: #0b1629;
        color: #f7f3e8;
        font-family: system-ui, sans-serif;
        padding: 2.5rem 1.25rem 5rem;
      }
      .wrap {
        max-width: 920px;
        margin: 0 auto;
      }
      h1 {
        font-size: 1.4rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
      }
      .lead {
        color: #b6bcc2;
        font-size: 0.9rem;
        max-width: 60ch;
        margin-bottom: 2.5rem;
        line-height: 1.5;
      }
      .lead strong {
        color: #f7f3e8;
      }
      h2 {
        font-size: 0.75rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #c8912a;
        border-bottom: 1px solid rgba(200, 145, 42, 0.3);
        padding-bottom: 0.75rem;
        margin: 3rem 0 1.5rem;
      }
      .card {
        background: rgba(247, 243, 232, 0.04);
        border: 1px solid rgba(247, 243, 232, 0.1);
        padding: 1.75rem 1.5rem;
        margin-bottom: 1.25rem;
      }
      .card .label {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #9ca3a8;
        margin-bottom: 0.9rem;
      }
      .card .label b {
        color: #d4af37;
        font-size: 0.75rem;
      }
      .sample-name {
        font-size: 3.4rem;
        line-height: 1;
        margin: 0 0 0.5rem;
      }
      .sample-line {
        font-size: 1.15rem;
        color: #d8d4c6;
        margin: 0;
      }
      .sample-headline {
        font-size: 2.1rem;
        line-height: 1.05;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        margin: 0;
      }
      footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(247, 243, 232, 0.1);
        font-size: 0.8rem;
        color: #9ca3a8;
        line-height: 1.6;
      }
      @media (max-width: 480px) {
        .sample-name {
          font-size: 2.4rem;
        }
        .sample-headline {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1>Mockup de tipografía — Morcat</h1>
      <p class="lead">
        Página interna de comparación, no es parte del sitio final. Grupo 1: variantes
        script/manuscrita para el nombre <strong>"Morcat"</strong> (buscando un punto medio
        entre muy pegada e ilegible, y muy abierta). Grupo 2: alternativas gratuitas a
        <strong>Haettenschweiler</strong> — es una fuente comercial de Monotype, no se puede
        incrustar en una web pública sin licencia de web font.
      </p>

      <h2>Grupo 1 — Script / manuscrita</h2>
      {
        scriptFonts.map((f) => (
          <div class="card">
            <div class="label">
              <span>{f.name}</span>
              <b>{f.tag}</b>
            </div>
            <p class="sample-name" style={{ fontFamily: f.family }}>
              Morcat
            </p>
            <p class="sample-line" style={{ fontFamily: f.family }}>
              Viviendas pensadas para Tierra del Fuego
            </p>
          </div>
        ))
      }

      <h2>Grupo 2 — Condensada / industrial (alternativa a Haettenschweiler)</h2>
      {
        condensedFonts.map((f) => (
          <div class="card">
            <div class="label">
              <span>{f.name}</span>
              <b>{f.tag}</b>
            </div>
            <p class="sample-headline" style={{ fontFamily: f.family, fontWeight: f.weight ?? 400 }}>
              Construimos otra forma de habitar el sur.
            </p>
          </div>
        ))
      }

      <footer>
        Elegí un nombre de fuente de cada grupo (o ninguno, si preferís seguir mirando
        opciones) y se aplica al sitio. Esta página se borra una vez definida la
        tipografía.
      </footer>
    </div>
  </body>
</html>
