---
/**
 * MORCAT — /capital (MORCAT CAPITAL SYSTEM)
 *
 * ⚠️ SECCIÓN DESACTIVADA por configuración
 * (FEATURES.capitalEnabled = false en src/config/features.ts).
 *
 * Mientras esté deshabilitada, la ruta redirige a 404 y no
 * aparece en ningún menú. Al habilitarla, esta página muestra
 * la presentación de fideicomisos y estructuras de inversión
 * (solo cuando exista información legal y comercial validada).
 */
import { FEATURES } from '../config/features';

if (!FEATURES.capitalEnabled) {
  return Astro.redirect('/404');
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MORCAT Capital System — Próximamente</title>
    <meta name="robots" content="noindex, follow" />
  </head>
  <body style="margin:0;background:#050d16;color:#f4f2ec;font-family:system-ui,sans-serif">
    <main style="min-height:100vh;display:grid;place-items:center;text-align:center;padding:2rem">
      <div>
        <p style="letter-spacing:.3em;text-transform:uppercase;font-size:.75rem;color:#d39a29">MORCAT Capital System</p>
        <h1 style="font-size:2.2rem;margin:.75rem 0">Estructuras de inversión.</h1>
        <p style="color:#9ca3a8;max-width:34rem">
          Esta sección se habilita cuando exista información legal y comercial validada.
        </p>
        <a href="/" style="display:inline-block;margin-top:1.5rem;padding:.9rem 1.8rem;background:#d39a29;color:#050d16;text-decoration:none;font-weight:700;letter-spacing:.12em">Volver al inicio</a>
      </div>
    </main>
  </body>
</html>
