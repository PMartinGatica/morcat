---
/**
 * MORCAT — /viviendas-modulares/[slug]
 * Página individual de cada modelo.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaImage from '../../components/MediaImage.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import Icon from '../../components/Icon.astro';
import {
  HOMES,
  bathroomsLabel,
  bedroomsLabel,
  surfaceLabel,
  surfacesLabel,
} from '../../data/homes';
import type { Crumb } from '../../lib/seo/structuredData';

export function getStaticPaths() {
  return HOMES.map((model) => ({
    params: { slug: model.slug },
    props: { model },
  }));
}

interface Props {
  model: (typeof HOMES)[number];
}

const { model } = Astro.props;
const index = HOMES.findIndex((h) => h.slug === model.slug);
const prev = HOMES[(index - 1 + HOMES.length) % HOMES.length];
const next = HOMES[(index + 1) % HOMES.length];

const crumbs: Crumb[] = [
  { name: 'Inicio', path: '/' },
  { name: 'Viviendas modulares', path: '/viviendas-modulares' },
  { name: model.name, path: `/viviendas-modulares/${model.slug}` },
];

const specs = [
  { label: 'Superficies', value: surfacesLabel(model) },
  { label: 'Opciones', value: model.variants.length > 0 ? String(model.variants.length) : 'Consultar' },
];
---

<BaseLayout
  title={`Modelo ${model.name} · Vivienda modular en Tierra del Fuego`}
  description={model.shortDescription}
  canonicalPath={`/viviendas-modulares/${model.slug}`}
  breadcrumbs={crumbs}
>
  <!-- HERO -->
  <section class="relative flex min-h-[80svh] items-end overflow-hidden bg-navy-950 pt-36">
    <div class="absolute inset-0">
      <MediaImage
        src={model.coverImage}
        alt={`Vivienda modular ${model.name} — ${model.shortDescription}`}
        class="h-full w-full object-cover"
        eager
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/50 to-navy-950/35" aria-hidden="true" />

    <div class="wrap relative z-10 pb-16">
      <div class="flex flex-wrap items-center gap-3 intro-item" style="animation-delay: .1s">
        <span class="text-[11px] uppercase tracking-[0.24em] text-mist-400">{model.line}</span>
      </div>

      <h1 class="display-xl mt-5 text-warm-50 intro-item" style="animation-delay: .2s">
        {model.name}
      </h1>

      <dl class="mt-8 grid max-w-2xl grid-cols-2 gap-px border border-warm-50/12 bg-warm-50/12 sm:grid-cols-3 intro-item" style="animation-delay: .3s">
        {specs.map((s) => (
          <div class="flex min-w-0 flex-col bg-navy-950/80 p-4">
            <dt class="text-[10px] font-semibold uppercase tracking-[0.2em] text-mist-400">{s.label}</dt>
            <dd class:list={['display mt-auto flex min-h-7 items-end pt-2 leading-none text-warm-50', /^\d/.test(s.value) ? 'text-xl' : 'text-[13px] sm:text-sm']}>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- DESCRIPCIÓN + CTA -->
  <section class="relative bg-navy-900 py-20 sm:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div data-reveal>
        <div class="eyebrow">
          <span>El modelo</span>
        </div>
        <h2 class="display mt-5 text-3xl text-warm-50">
          Pensado para el <span class="serif-accent text-gold-500">sur.</span>
        </h2>
        <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-mist-300 sm:text-base">
          {model.description}
        </p>
        <p class="mt-4 text-[13px] text-mist-500">
          Los datos de este modelo son de referencia inicial y pueden ajustarse. La
          cotización definitiva se define con el proyecto puntual.
        </p>
      </div>

      <aside class="border border-warm-50/12 bg-navy-800/60 p-7" data-reveal>
        <h3 class="display text-lg text-warm-50">¿Te interesa este modelo?</h3>
        <p class="mt-3 text-[14px] leading-relaxed text-mist-400">
          Solicitá una cotización y te contactamos con la información disponible.
        </p>
        <div class="mt-6 space-y-3">
          <a href="/contacto" class="btn btn-gold w-full">
            Solicitar cotización
            <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
          <a href="/viviendas-modulares" class="btn btn-ghost w-full">
            Ver otros modelos
          </a>
        </div>
        <p class="mt-5 text-[12px] leading-relaxed text-mist-500">
          No publicamos precios: se definen según modelo, terreno, fundación y
          terminaciones.
        </p>
      </aside>
    </div>
  </section>

  <!-- OPCIONES DISPONIBLES (una tarjeta por medida) -->
  <section class="bg-navy-950 py-20 sm:py-24" aria-labelledby="medidas">
    <div class="wrap">
      <div data-reveal>
        <div class="eyebrow">
          <span>Opciones disponibles</span>
        </div>
        <h2 id="medidas" class="display mt-4 text-2xl text-warm-50 sm:text-3xl">
          Elegí la <span class="serif-accent text-gold-500">medida.</span>
        </h2>
      </div>

      {model.variants.length > 0 ? (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {model.variants.map((v, i) => (
            <article class="flex flex-col border border-warm-50/12 bg-navy-900" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              {(() => {
                const imgs = v.images && v.images.length > 0 ? v.images : v.image ? [v.image] : [];
                if (imgs.length === 0) return null;
                return (
                  <div class="relative aspect-[4/3] overflow-hidden bg-navy-800" data-variant-carousel>
                    {imgs.map((src, i) => (
                      <div
                        class="absolute inset-0 transition-opacity duration-300"
                        data-variant-slide
                        style={i === 0 ? undefined : 'opacity:0; pointer-events:none;'}
                      >
                        <MediaImage
                          src={src}
                          alt={`${model.name} de ${surfaceLabel(v.surface)} — imagen ${i + 1}`}
                          class="h-full w-full object-cover"
                          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                        />
                      </div>
                    ))}
                    {imgs.length > 1 && (
                      <>
                        <button
                          type="button"
                          data-variant-prev
                          aria-label="Imagen anterior"
                          class="absolute left-2 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center border border-warm-50/20 bg-navy-950/60 text-warm-50 backdrop-blur-sm transition-colors hover:border-gold-500 hover:text-gold-400"
                        >
                          <Icon name="chevron-left" class="h-4 w-4" />
                        </button>
                        <button
                          type="button"
                          data-variant-next
                          aria-label="Imagen siguiente"
                          class="absolute right-2 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center border border-warm-50/20 bg-navy-950/60 text-warm-50 backdrop-blur-sm transition-colors hover:border-gold-500 hover:text-gold-400"
                        >
                          <Icon name="chevron-right" class="h-4 w-4" />
                        </button>
                      </>
                    )}
                  </div>
                );
              })()}
              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="display text-3xl text-warm-50">{surfaceLabel(v.surface)}</p>
                  {v.code && (
                    <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-gold-400">
                      Código {v.code}
                    </span>
                  )}
                </div>
                <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-warm-50/10 pt-5">
                  <div>
                    <dt class="text-[10px] font-semibold uppercase tracking-[0.2em] text-mist-500">Dormitorios</dt>
                    <dd class="mt-1 text-[14px] text-warm-100">{bedroomsLabel(v)}</dd>
                  </div>
                  <div>
                    <dt class="text-[10px] font-semibold uppercase tracking-[0.2em] text-mist-500">Baños</dt>
                    <dd class="mt-1 text-[14px] text-warm-100">{bathroomsLabel(v)}</dd>
                  </div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-10 border border-warm-50/12 bg-navy-900 p-8" data-reveal>
          <p class="display text-xl text-warm-50">Medidas a consultar</p>
          <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-mist-400">
            Estamos cargando las medidas y ambientes de este modelo. Consultanos y te
            pasamos las opciones disponibles.
          </p>
          <a href="/contacto" class="btn btn-gold mt-6">
            Consultar medidas
            <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
        </div>
      )}

      <p class="mt-6 text-[13px] text-mist-500">
        Medidas y ambientes de referencia: pueden ajustarse según el proyecto.
      </p>
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="border-y border-warm-50/10 bg-navy-900 py-20 sm:py-24" aria-labelledby="galeria">
    <div class="wrap">
      <div class="flex items-end justify-between gap-6">
        <div data-reveal>
          <div class="eyebrow">
            <span>Galería</span>
          </div>
          <h2 class="display mt-4 text-2xl text-warm-50 sm:text-3xl">El modelo en imágenes</h2>
        </div>
      </div>
      <div class="mt-10">
        <ProjectGallery images={model.gallery} altPrefix={`Modelo ${model.name}`} />
      </div>
    </div>
  </section>

  <!-- CARACTERÍSTICAS + SISTEMA -->
  <section class="border-y border-warm-50/10 bg-navy-900 py-20 sm:py-24">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <div class="eyebrow">
          <span>Características</span>
        </div>
        <h2 class="display mt-4 text-2xl text-warm-50 sm:text-3xl">Qué incluye</h2>
        <ul class="mt-8 space-y-4">
          {model.features.map((feature) => (
            <li class="flex items-start gap-4 border-b border-warm-50/10 pb-4 text-[15px] text-warm-100">
              <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-gold-500" />
              {feature}
            </li>
          ))}
        </ul>
      </div>

      <div data-reveal>
        <div class="eyebrow">
          <span>Sistema constructivo</span>
        </div>
        <h2 class="display mt-4 text-2xl text-warm-50 sm:text-3xl">Industrializado</h2>
        <p class="mt-6 text-[15px] leading-relaxed text-mist-300">
          Este modelo se desarrolla con sistema industrializado: componentes fabricados en
          fábrica y montados en terreno. Esto reduce la dependencia del clima y mejora el
          control de calidad del proceso.
        </p>
        <div class="mt-8 grid gap-px border border-warm-50/10 bg-warm-50/10 sm:grid-cols-2">
          {[
            { t: 'Producción en fábrica', d: 'Mayor precisión y menos imprevistos de clima.' },
            { t: 'Montaje en terreno', d: 'La obra en sitio se reduce a lo esencial.' },
            { t: 'Diseño para el sur', d: 'Aislación y detalles pensados para TdF.' },
            { t: 'Opciones a consultar', d: 'Terminaciones y distribución según proyecto.' },
          ].map((item) => (
            <div class="bg-navy-900 p-5">
              <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-gold-400">{item.t}</p>
              <p class="mt-2 text-[13px] leading-relaxed text-mist-400">{item.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PERSONALIZACIÓN -->
  <section class="bg-navy-950 py-20 sm:py-24">
    <div class="wrap">
      <div data-reveal>
        <div class="eyebrow">
          <span>Personalización</span>
        </div>
        <h2 class="display mt-4 text-2xl text-warm-50 sm:text-3xl">
          El modelo se <span class="serif-accent text-gold-500">adapta.</span>
        </h2>
      </div>
      <div class="mt-10 grid gap-px border border-warm-50/10 bg-warm-50/10 md:grid-cols-3">
        {[
          { t: 'Distribución', d: 'Reordenamos ambientes según tu forma de vivir.' },
          { t: 'Terminaciones', d: 'Revestimientos, pisos y detalles a elección.' },
          { t: 'Terreno y fundación', d: 'Definimos el sistema según el lote y el suelo.' },
          { t: 'Ampliación a futuro', d: 'La estructura permite sumar módulos después.' },
          { t: 'Uso', d: 'Vivienda principal, refugio, alquiler o estudio.' },
          { t: 'Presupuesto', d: 'Te asesoramos para ajustar alcance y costos.' },
        ].map((o, i) => (
          <div class="bg-navy-900 p-6" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <span class="font-mono text-[12px] font-bold text-gold-500">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display mt-3 text-base text-warm-50">{o.t}</h3>
            <p class="mt-2 text-[13px] leading-relaxed text-mist-400">{o.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-warm-50/10 bg-navy-900 py-20">
    <div class="wrap text-center">
      <h2 class="display text-3xl text-warm-50 sm:text-4xl" data-reveal>
        ¿Listo para <span class="serif-accent text-gold-500">cotizar?</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-[14px] text-mist-400" data-reveal>
        Contanos tu terreno y lo que tenés en mente. Evaluamos juntos el modelo y la
        mejor alternativa.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4" data-reveal>
        <a href="/contacto" class="btn btn-gold">
          Solicitar cotización
          <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
        <a href="/viviendas-modulares" class="btn btn-ghost">Volver al catálogo</a>
      </div>
    </div>
  </section>

  <!-- NAVEGACIÓN ENTRE MODELOS -->
  <nav class="border-t border-warm-50/10 bg-navy-900" aria-label="Otros modelos">
    <div class="wrap grid gap-px sm:grid-cols-2">
      <a href={`/viviendas-modulares/${prev.slug}`} class="group flex items-center gap-5 py-8 transition-colors hover:bg-navy-800">
        <Icon name="chevron-left" class="h-5 w-5 shrink-0 text-gold-500" />
        <span>
          <span class="block text-[10px] uppercase tracking-[0.24em] text-mist-500">Modelo anterior</span>
          <span class="display mt-1 block text-lg text-warm-50 group-hover:text-gold-300">{prev.name}</span>
        </span>
      </a>
      <a href={`/viviendas-modulares/${next.slug}`} class="group flex items-center justify-end gap-5 py-8 text-right transition-colors hover:bg-navy-800">
        <span>
          <span class="block text-[10px] uppercase tracking-[0.24em] text-mist-500">Siguiente modelo</span>
          <span class="display mt-1 block text-lg text-warm-50 group-hover:text-gold-300">{next.name}</span>
        </span>
        <Icon name="chevron-right" class="h-5 w-5 shrink-0 text-gold-500" />
      </a>
    </div>
  </nav>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-variant-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-variant-slide]'));
    let active = 0;

    const show = (i: number) => {
      active = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => {
        const isActive = idx === active;
        s.style.opacity = isActive ? '1' : '0';
        s.style.pointerEvents = isActive ? 'auto' : 'none';
      });
    };

    root.querySelector('[data-variant-prev]')?.addEventListener('click', () => show(active - 1));
    root.querySelector('[data-variant-next]')?.addEventListener('click', () => show(active + 1));
  });
</script>
