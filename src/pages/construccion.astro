---
/**
 * MORCAT — /construccion
 * Construcción tradicional, casas, dúplex y proyectos a medida.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ConstructionProcess from '../components/ConstructionProcess.astro';
import Icon from '../components/Icon.astro';
import MediaImage from '../components/MediaImage.astro';
import { CONSTRUCTION_LINES, CONSTRUCTION_SYSTEMS, CONSTRUCTION_MEDIA } from '../data/construction';

const TITLE = 'Construcción de Casas y Dúplex en Tierra del Fuego | Proyectos a medida — MORCAT';
const DESCRIPTION =
  'Construcción de casas, dúplex, ampliaciones y proyectos personalizados en Tierra del Fuego. Del plano a la obra, con sistemas tradicionales o industrializados.';
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Construcción', path: '/construccion' },
  ]}
>
  <!-- HERO -->
  <section class="relative flex min-h-[72svh] items-end overflow-hidden bg-navy-950 pt-36">
    <div class="absolute inset-0">
      <MediaImage
        src="duplex/hero-vela"
        alt="Dúplex MORCAT con ventanas tipo vela, construcción en madera y chapa"
        class="h-full w-full object-cover"
        eager
        sizes="100vw"
        widths={[768, 1200, 1600, 2400]}
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/55 to-navy-950/40" aria-hidden="true" />

    <div class="wrap relative z-10 pb-20">
      <p class="eyebrow intro-item" style="animation-delay: .1s">Construcción · Tierra del Fuego</p>
      <h1 class="display-xl mt-6 text-warm-50">
        <span class="block intro-item" style="animation-delay: .2s">Construimos</span>
        <span class="block intro-item" style="animation-delay: .3s">tu proyecto</span>
        <span class="block intro-item" style="animation-delay: .4s">
          <span class="serif-accent text-gold-500">a medida.</span>
        </span>
      </h1>
      <p class="intro-item mt-6 max-w-xl text-[15px] leading-relaxed text-mist-300 sm:text-base" style="animation-delay: .5s">
        Casas, dúplex, ampliaciones y proyectos personalizados. Te acompañamos desde la
        idea hasta la obra terminada.
      </p>
      <div class="intro-item mt-9 flex flex-wrap gap-4" style="animation-delay: .6s">
        <a href="/contacto" class="btn btn-gold">
          Cotizar proyecto
          <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
        <a href="#proceso" class="btn btn-ghost">
          Ver el proceso
          <Icon name="arrow-down" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- LÍNEAS DE CONSTRUCCIÓN -->
  <section class="relative bg-navy-900 py-20 sm:py-28">
    <div class="wrap">
      <SectionHeader
        index="01"
        eyebrow="Qué construimos"
        title="Casas, dúplex y"
        accent="proyectos a medida."
        description="Cada obra se piensa para su proyecto, su presupuesto y la zona, adaptándose a tu necesidad. Estas son las líneas de trabajo principales."
      />

      <div class="mt-14 grid gap-px border border-warm-50/10 bg-warm-50/10 sm:grid-cols-2 lg:grid-cols-3">
        {CONSTRUCTION_LINES.map((line, i) => (
          <article class="group bg-navy-900 p-7 transition-colors duration-300 hover:bg-navy-800" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span class="font-mono text-[12px] font-bold text-gold-500">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="display mt-4 text-xl text-warm-50">{line.title}</h3>
            <p class="mt-3 text-[14px] leading-relaxed text-mist-400">{line.description}</p>
            <span class="mt-5 block h-px w-10 bg-gold-500/50 transition-all duration-500 group-hover:w-full" aria-hidden="true" />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section id="proceso" class="relative border-y border-warm-50/10 bg-navy-950 py-20 sm:py-28">
    <div class="wrap">
      <SectionHeader
        index="02"
        eyebrow="Cómo trabajamos"
        title="Del plano"
        accent="a la obra."
        description="MORCAT puede trabajar desde la definición inicial del proyecto hasta la construcción y entrega."
        align="center"
      />
      <div class="mt-16">
        <ConstructionProcess />
      </div>
    </div>
  </section>

  <!-- SISTEMAS -->
  <section class="bg-navy-900 py-20 sm:py-28">
    <div class="wrap">
      <SectionHeader
        index="03"
        eyebrow="Sistemas constructivos"
        title="Tradicional o"
        accent="industrializado."
        description="El sistema se elige según el proyecto y el terreno: cada uno tiene ventajas distintas según el programa y el presupuesto."
      />

      <div class="mt-14 grid gap-px border border-warm-50/10 bg-warm-50/10 sm:grid-cols-2 lg:grid-cols-4">
        {CONSTRUCTION_SYSTEMS.map((sys, i) => (
          <article class="group bg-navy-900 p-7 transition-colors duration-300 hover:bg-navy-800" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <Icon name={sys.icon} class="h-8 w-8 text-gold-500" />
            <h3 class="display mt-6 text-lg text-warm-50">{sys.name}</h3>
            <p class="mt-4 text-[13px] leading-relaxed text-mist-400">{sys.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DETALLE CONSTRUCTIVO -->
  <section class="border-t border-warm-50/10 bg-navy-950 py-20 sm:py-28">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <SectionHeader
          index="04"
          eyebrow="Obra y detalles"
          title="La base importa"
          accent="tanto como la vivienda."
        />
        <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-mist-300 sm:text-base">
          En el sistema industrializado, la fundación se resuelve con una platea flotante:
          apoya la estructura sobre el terreno sin necesidad de una excavación profunda,
          algo clave en suelos con permafrost o napa alta como los de Tierra del Fuego.
        </p>
      </div>

      <div class="card-media aspect-[4/3]" data-reveal="left">
        <MediaImage
          src={CONSTRUCTION_MEDIA.plateaFlotante}
          alt="Detalle constructivo de platea flotante"
          class="h-full w-full object-cover"
          sizes="(min-width: 1024px) 45vw, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- VIVIENDAS -->
  <section class="border-t border-warm-50/10 bg-navy-950 py-20 sm:py-28">
    <div class="wrap flex flex-col items-center gap-6 text-center">
      <SectionHeader
        index="05"
        eyebrow="Catálogo"
        title="Conocé nuestras"
        accent="viviendas."
        align="center"
      />
      <p class="max-w-xl text-[15px] leading-relaxed text-mist-300 sm:text-base">
        Todos los proyectos realizados por MORCAT están en el catálogo de viviendas.
      </p>
      <a href="/viviendas-modulares" class="btn btn-gold" data-reveal>
        Ver viviendas
        <Icon name="arrow-up-right" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-warm-50/10 bg-navy-900 py-16">
    <div class="wrap flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <div data-reveal>
        <h2 class="display text-2xl text-warm-50 sm:text-3xl">¿Tenés un proyecto en mente?</h2>
        <p class="mt-2 text-[14px] text-mist-400">
          Evaluamos juntos el alcance, el sistema constructivo y el presupuesto de tu proyecto.
        </p>
      </div>
      <a href="/contacto" class="btn btn-gold shrink-0" data-reveal>
        Cotizar proyecto
        <Icon name="arrow-up-right" class="h-4 w-4" />
      </a>
    </div>
  </section>
</BaseLayout>
