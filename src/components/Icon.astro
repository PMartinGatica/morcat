---

{
  BRAND[name] ? (
    <svg
      viewBox={BRAND[name].viewBox ?? '0 0 24 24'}
      class={className}
      role="img"
      aria-hidden="true"
      fill="currentColor"
      {...rest}
    >
      <path d={BRAND[name].d} />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" class={className} role="img" aria-hidden="true" {...STROKE} {...rest}>
      {STROKE_ICONS[name]?.map((d) => <path d={d} />)}
    </svg>
  )
}
