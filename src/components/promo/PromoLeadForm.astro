---
/**
 * MORCAT — Formulario de lead de la landing (corto y rápido).
 *
 * - Campos mínimos: nombre, WhatsApp, email, terreno, ubicación,
 *   modelo de interés (dinámico desde homes.ts), uso previsto y
 *   mensaje.
 * - Captura UTM automática y los persiste en la sesión.
 * - Envío resuelto en src/lib/forms/submit.ts: endpoint propio
 *   (n8n / CRM / API) o email sin backend, con fallback mailto.
 */
import Icon from '../Icon.astro';
import { HOMES, modelLabel } from '../../data/homes';
import { SITE } from '../../config/site';
import type { Promo } from '../../data/promos';

interface Props {
  form: Promo['form'];
  source: string;
}

const { form, source } = Astro.props;

const USOS = ['Vivienda', 'Ampliación', 'Proyecto turístico', 'Inversión', 'Otro'];
const TERRENO_OPTIONS = ['Sí', 'No', 'Estoy buscando'];
---

<section id="promo-form" class="relative bg-navy-950 py-24 sm:py-32" aria-labelledby="promo-form-title">
  <div class="grid-lines absolute inset-0 opacity-60" aria-hidden="true" />

  <div class="wrap relative max-w-3xl">
    <div class="text-center" data-reveal>
      <div class="eyebrow-center">
        <span>Formulario</span>
      </div>
      <h2 id="promo-form-title" class="display mt-5 text-4xl text-warm-50 sm:text-5xl">
        {form.title}
        <span class="block"><span class="serif-accent text-gold-500">{form.accentLine}</span></span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-[14px] text-mist-400">{form.subtitle}</p>
    </div>

    <form
      class="mt-12 border border-warm-50/12 bg-navy-900/80 p-6 backdrop-blur-sm sm:p-9"
      data-promo-lead-form
      data-source={source}
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="plf-nombre" class="field-label">Nombre *</label>
          <input id="plf-nombre" name="nombre" type="text" autocomplete="given-name" required class="field" placeholder="Tu nombre" />
          <span class="field-error" data-error-for="nombre" hidden></span>
        </div>
        <div>
          <label for="plf-whatsapp" class="field-label">WhatsApp *</label>
          <input id="plf-whatsapp" name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" required class="field" placeholder="+54 9 2901 ..." />
          <span class="field-error" data-error-for="whatsapp" hidden></span>
        </div>

        <div class="sm:col-span-2">
          <label for="plf-email" class="field-label">Email <span class="normal-case tracking-normal text-mist-500">(opcional)</span></label>
          <input id="plf-email" name="email" type="email" autocomplete="email" class="field" placeholder="tucorreo@ejemplo.com" />
          <span class="field-error" data-error-for="email" hidden></span>
        </div>

        <!-- ¿Tenés terreno? -->
        <fieldset class="sm:col-span-2">
          <legend class="field-label">¿Tenés terreno?</legend>
          <div class="flex flex-wrap gap-3">
            {TERRENO_OPTIONS.map((opt, i) => (
              <label
                class={`flex cursor-pointer items-center gap-2.5 border px-4 py-3 text-[13px] font-semibold transition-colors duration-300 ${
                  i === 0 ? 'border-gold-500/60 text-gold-300' : 'border-warm-50/15 text-warm-100 hover:border-gold-500/40'
                }`}
              >
                <input
                  type="radio"
                  name="tenesTerreno"
                  value={opt}
                  checked={i === 0}
                  class="h-4 w-4 accent-gold-500"
                />
                {opt}
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="plf-ubicacion" class="field-label">Ubicación del terreno <span class="normal-case tracking-normal text-mist-500">(opcional)</span></label>
          <input id="plf-ubicacion" name="ubicacionTerreno" type="text" class="field" placeholder="Barrio, zona o ciudad" />
        </div>
        <div>
          <label for="plf-modelo" class="field-label">Modelo de interés</label>
          <select id="plf-modelo" name="modeloInteres" class="field appearance-none">
            <option value="">No sé todavía</option>
            {HOMES.map((m) => (
              <option value={m.slug}>{modelLabel(m)}</option>
            ))}
            <option value="otro">Otro</option>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="plf-uso" class="field-label">Uso previsto</label>
          <select id="plf-uso" name="usoPrevisto" class="field appearance-none">
            {USOS.map((u) => <option value={u}>{u}</option>)}
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="plf-mensaje" class="field-label">Mensaje <span class="normal-case tracking-normal text-mist-500">(opcional)</span></label>
          <textarea id="plf-mensaje" name="mensaje" rows="3" class="field resize-y" placeholder="Contanos brevemente tu proyecto."></textarea>
        </div>
      </div>

      <!-- Honeypot -->
      <div class="hidden" aria-hidden="true">
        <label for="plf-web">No completar</label>
        <input id="plf-web" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <button type="submit" class="btn btn-gold w-full sm:w-auto" data-lead-submit>
          <span data-lead-label>{form.submitLabel}</span>
          <span data-lead-spinner class="hidden" aria-hidden="true">
            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="3" />
              <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
          </span>
          <Icon name="arrow-right" class="h-4 w-4" data-lead-arrow />
        </button>
        <p class="text-[12px] leading-relaxed text-mist-500">
          Tu consulta llega directo a nuestro email. Respondemos en horario de oficina.
        </p>
      </div>

      <p class="mt-5 border border-gold-500/40 bg-gold-500/10 p-4 text-[14px] text-warm-50" data-lead-success role="status" hidden></p>
      <div class="mt-5 border border-red-400/40 bg-red-400/10 p-4" data-lead-error role="alert" hidden>
        <p class="text-[14px] text-warm-50" data-lead-error-text></p>
        <a class="mt-3 inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.16em] text-gold-300 underline" data-lead-mailto href={`mailto:${SITE.email}`}>
          Enviar por email
        </a>
      </div>
    </form>

    <p class="mt-5 text-center text-[11px] text-mist-500" data-reveal="fade">
      Tus datos se usan únicamente para responder tu consulta.
    </p>
  </div>
</section>

<script>
  import { FORMS } from '../../config/forms';
  import { buildLeadPayload, getPersistedUtm, persistUtm } from '../../lib/utils/utm';
  import { submitLead, buildMailto, successMessage } from '../../lib/forms/submit';
  import { trackEvent } from '../../lib/analytics/track';

  const form = document.querySelector<HTMLFormElement>('[data-promo-lead-form]');
  if (!form) throw new Error('PromoLeadForm: formulario no encontrado');

  const fields = {
    nombre: form.querySelector<HTMLInputElement>('#plf-nombre')!,
    whatsapp: form.querySelector<HTMLInputElement>('#plf-whatsapp')!,
    email: form.querySelector<HTMLInputElement>('#plf-email')!,
    ubicacion: form.querySelector<HTMLInputElement>('#plf-ubicacion')!,
  };

  const submitBtn = form.querySelector<HTMLButtonElement>('[data-lead-submit]')!;
  const submitLabel = form.querySelector<HTMLElement>('[data-lead-label]')!;
  const spinner = form.querySelector<HTMLElement>('[data-lead-spinner]')!;
  const arrow = form.querySelector<HTMLElement>('[data-lead-arrow]')!;
  const successBox = form.querySelector<HTMLElement>('[data-lead-success]')!;
  const errorBox = form.querySelector<HTMLElement>('[data-lead-error]')!;
  const errorText = form.querySelector<HTMLElement>('[data-lead-error-text]')!;
  const mailtoLink = form.querySelector<HTMLAnchorElement>('[data-lead-mailto]')!;
  const source = form.dataset.source ?? 'promo';

  // UTM: persistir y precargar modelo según utm_content (ej. homero_a01)
  const utm = persistUtm();
  const modeloSelect = form.querySelector<HTMLSelectElement>('#plf-modelo')!;
  const content = utm.utm_content.toLowerCase().replace(/_/g, '-');
  if (content) {
    const match = Array.from(modeloSelect.options).find((o) => o.value === content);
    if (match) modeloSelect.value = match.value;
  }

  // form_start: primer input del usuario
  let started = false;
  form.addEventListener('input', () => {
    if (!started) {
      started = true;
      trackEvent('form_start', {});
    }
  }, { once: true });

  function setError(name: string, message: string | null): void {
    const field = fields[name as keyof typeof fields];
    const box = form!.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;
    if (!field) return;
    if (message) {
      box.textContent = message;
      box.hidden = false;
      field.setAttribute('aria-invalid', 'true');
      field.classList.add('border-red-400/70');
    } else {
      box.textContent = '';
      box.hidden = true;
      field.removeAttribute('aria-invalid');
      field.classList.remove('border-red-400/70');
    }
  }

  function validate(): boolean {
    let ok = true;
    const value = (name: string) => (fields[name as keyof typeof fields]?.value ?? '').trim();
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const waRe = /^\+?[\d\s-]{8,20}$/;

    if (!value('nombre')) { setError('nombre', 'Ingresá tu nombre.'); ok = false; } else setError('nombre', null);
    if (!value('whatsapp')) { setError('whatsapp', 'Ingresá tu WhatsApp.'); ok = false; }
    else if (!waRe.test(value('whatsapp'))) { setError('whatsapp', 'El número no parece válido.'); ok = false; }
    else setError('whatsapp', null);
    if (value('email') && !emailRe.test(value('email'))) { setError('email', 'El email no parece válido.'); ok = false; }
    else setError('email', null);

    return ok;
  }

  function setLoading(loading: boolean): void {
    submitBtn.disabled = loading;
    submitLabel.textContent = loading
      ? 'ENVIANDO…'
      : (submitLabel.dataset.original ?? 'QUIERO RECIBIR INFORMACIÓN');
    spinner.classList.toggle('hidden', !loading);
    arrow.classList.toggle('hidden', loading);
  }
  submitLabel.dataset.original = submitLabel.textContent ?? 'QUIERO RECIBIR INFORMACIÓN';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    successBox.hidden = true;
    errorBox.hidden = true;

    // Honeypot
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    if (honeypot?.value) {
      successBox.textContent = successMessage('email');
      successBox.hidden = false;
      form.reset();
      return;
    }

    if (!validate()) {
      trackEvent('form_error', { reason: 'validation' });
      return;
    }

    const payload = buildLeadPayload({
      source,
      campaign: getPersistedUtm().utm_campaign,
      model: modeloSelect.value,
      name: fields.nombre.value.trim(),
      whatsapp: fields.whatsapp.value.trim(),
      email: fields.email.value.trim(),
      hasLand: form.querySelector<HTMLInputElement>('input[name="tenesTerreno"]:checked')?.value ?? '',
      landLocation: fields.ubicacion.value.trim(),
      intendedUse: form.querySelector<HTMLSelectElement>('#plf-uso')?.value ?? '',
      message: form.querySelector<HTMLTextAreaElement>('#plf-mensaje')?.value.trim() ?? '',
    });

    trackEvent('form_submit', { model: payload.model });
    setLoading(true);
    const result = await submitLead(payload, {
      subject: `${FORMS.email.subject} · ${payload.model || 'sin modelo'}`,
    });
    setLoading(false);

    if (result.ok) {
      successBox.textContent = successMessage(result.channel);
      successBox.hidden = false;
      trackEvent('form_success', { model: payload.model, channel: result.channel });
      form.reset();
      return;
    }

    // Fallback: mailto con la consulta ya redactada
    errorText.textContent = FORMS.errorMessage;
    mailtoLink.href = buildMailto(payload);
    errorBox.hidden = false;
    trackEvent('form_error', { reason: 'submit-failed' });
  });
</script>
