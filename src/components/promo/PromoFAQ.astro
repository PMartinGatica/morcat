---
/**
 * MORCAT — FAQ de la landing (claro).
 * Respuestas prudentes: sin inventar políticas comerciales.
 */
import Icon from '../Icon.astro';
import type { Promo } from '../../data/promos';

interface Props {
  faqs: Promo['faqs'];
}

const { faqs } = Astro.props;
---

<section class="relative bg-warm-50 py-24 text-navy-950 sm:py-32" aria-labelledby="faq-title">
  <div class="wrap max-w-4xl">
    <div class="text-center" data-reveal>
      <div class="eyebrow-center">
        <span>Preguntas frecuentes</span>
      </div>
      <h2 id="faq-title" class="display mt-5 text-3xl text-navy-950 sm:text-4xl">
        Respuestas <span class="serif-accent text-gold-700">directas.</span>
      </h2>
    </div>

    <div class="mt-12 space-y-3">
      {faqs.map((faq, i) => (
        <details
          class="group border border-navy-950/12 bg-warm-50 transition-colors open:border-gold-600/50"
          data-reveal
          style={`--reveal-delay: ${i * 50}ms`}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-5 text-[15px] font-semibold text-navy-950 [&::-webkit-details-marker]:hidden">
            {faq.question}
            <span class="flex h-8 w-8 shrink-0 items-center justify-center border border-gold-600/40 text-gold-700 transition-transform duration-300 group-open:rotate-45">
              <Icon name="close" class="h-4 w-4" />
            </span>
          </summary>
          <p class="px-5 pb-5 text-[14px] leading-relaxed text-navy-700/80">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
