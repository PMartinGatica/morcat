---
/**
 * MORCAT — Casos de uso (claro).
 * "UNA BASE. DISTINTOS PROYECTOS."
 * Casos conceptuales, sin prometer rentabilidad ni retornos.
 */
import Icon from '../Icon.astro';
import type { Promo } from '../../data/promos';

interface Props {
  useCases: Promo['useCases'];
}

const { useCases } = Astro.props;
---

<section class="relative bg-warm-50 py-24 text-navy-950 sm:py-32" aria-labelledby="casos-title">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <div class="eyebrow">
        <span>{useCases.eyebrow}</span>
      </div>
      <h2 id="casos-title" class="display mt-5 text-4xl text-navy-950 sm:text-5xl">
        {useCases.title}
        <span class="block"><span class="serif-accent text-gold-700">{useCases.accentLine}</span></span>
      </h2>
    </div>

    <div class="mt-14 grid gap-px border border-navy-950/10 bg-navy-950/10 sm:grid-cols-2 lg:grid-cols-4">
      {useCases.items.map((item, i) => (
        <article class="bg-warm-50 p-7 transition-colors duration-300 hover:bg-warm-100" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <span class="flex h-12 w-12 items-center justify-center border border-gold-600/40 text-gold-700">
            <Icon name={item.icon} class="h-5 w-5" />
          </span>
          <h3 class="display mt-6 text-lg text-navy-950">{item.title}</h3>
          <p class="mt-3 text-[13px] leading-relaxed text-navy-700/75">{item.description}</p>
        </article>
      ))}
    </div>

    <p class="mt-6 text-[12px] leading-relaxed text-navy-700/60" data-reveal="fade">
      {useCases.disclaimer}
    </p>
  </div>
</section>
