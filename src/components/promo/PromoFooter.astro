---
/**
 * MORCAT — Pie mínimo de la landing de campaña.
 * Sin navegación corporativa; contacto directo y link discreto
 * "Conocé MORCAT".
 */
import Logo from '../Logo.astro';
import { SITE } from '../../config/site';
---

<footer class="border-t border-warm-50/10 bg-navy-950 py-10">
  <div class="wrap flex flex-col items-center gap-4 text-center">
    <Logo markOnly markClass="h-10 w-10" />

    <div>
      <p class="text-[13px] font-semibold text-warm-100">{SITE.legalName}</p>
      <p class="mt-1 text-[11px] uppercase tracking-[0.22em] text-mist-500">
        {SITE.province} · {SITE.city} · {SITE.country}
      </p>
    </div>

    <a
      href="/"
      class="text-[11px] font-bold uppercase tracking-[0.2em] text-gold-400 transition-colors hover:text-gold-300"
    >
      Conocé MORCAT →
    </a>

    <p class="text-[11px] text-mist-500">
      © {SITE.year} {SITE.legalName}
    </p>

    <p class="text-[11px] text-mist-500">
      <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-gold-400">
        {SITE.email}
      </a>
      <span class="mx-2 text-mist-500/50" aria-hidden="true">·</span>
      <a
        href={`https://wa.me/${SITE.whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-gold-400"
      >
        WhatsApp
      </a>
    </p>
  </div>
</footer>
