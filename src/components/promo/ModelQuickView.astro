---
/**
 * MORCAT — Quick view de modelo (modal / bottom sheet).
 *
 * El usuario explora el modelo SIN abandonar la landing:
 * imágenes, superficie, planta, ambientes y CTA de WhatsApp.
 * La ficha completa queda a un clic (/viviendas-modulares/[slug]).
 *
 * Cada modelo se renderiza en el servidor (panel oculto); el JS
 * solo muestra el panel correspondiente. Vanilla JS — sin React.
 */
import Icon from '../Icon.astro';
import MediaImage from '../MediaImage.astro';
import { HOMES } from '../../data/homes';
import { modelWhatsAppLink } from '../../lib/promo/whatsapp';

interface Props {
  models?: typeof HOMES;
}

const models = Astro.props.models ?? HOMES;
---

<!-- MODAL / BOTTOM SHEET -->
<div
  data-quickview
  class="fixed inset-0 z-[70] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="quickview-title"
>
  <div class="absolute inset-0 bg-navy-950/85 backdrop-blur-sm" data-quickview-backdrop></div>

  <div
    class="quickview-panel absolute inset-x-0 bottom-0 max-h-[88svh] overflow-y-auto border-t border-gold-500/30 bg-navy-950 shadow-card sm:inset-x-auto sm:left-1/2 sm:top-1/2 sm:bottom-auto sm:max-h-[85svh] sm:w-full sm:max-w-2xl sm:-translate-x-1/2 sm:-translate-y-1/2 sm:border sm:border-gold-500/30"
    data-quickview-panel
  >
    <!-- Cabecera -->
    <div class="sticky top-0 z-10 flex items-center justify-between border-b border-warm-50/10 bg-navy-950/95 px-5 py-4 backdrop-blur-sm">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-gold-400" data-qv-line></p>
        <h3 id="quickview-title" class="display mt-0.5 text-xl text-warm-50" data-qv-name></h3>
      </div>
      <button type="button" data-quickview-close aria-label="Cerrar" class="flex h-10 w-10 items-center justify-center border border-warm-50/20 text-warm-50 transition-colors hover:border-gold-500 hover:text-gold-400">
        <Icon name="close" class="h-4 w-4" />
      </button>
    </div>

    <!-- Paneles (uno por modelo, server-rendered) -->
    <div class="px-5 py-6 sm:px-8" data-quickview-panels>
      {models.map((m) => {
        const wa = modelWhatsAppLink(m.name, m.surface);
        return (
          <article class="hidden" data-qv-panel={m.slug} aria-hidden="true">
            <div class="grid gap-6 sm:grid-cols-[1.1fr_1fr]">
              <div class="space-y-4">
                <div class="relative aspect-[4/3] overflow-hidden bg-navy-800">
                  <MediaImage src={m.coverImage} alt={`Modelo ${m.name}`} class="h-full w-full object-cover" />
                </div>

                <div class="grid grid-cols-3 gap-px border border-warm-50/10 bg-warm-50/10">
                  <div class="bg-navy-900 p-3 text-center">
                    <p class="display text-lg text-warm-50">{m.surface}</p>
                    <p class="text-[9px] uppercase tracking-[0.18em] text-mist-400">m²</p>
                  </div>
                  <div class="bg-navy-900 p-3 text-center">
                    <p class="display text-lg text-warm-50">{m.bedrooms}</p>
                    <p class="text-[9px] uppercase tracking-[0.18em] text-mist-400">dorm.</p>
                  </div>
                  <div class="bg-navy-900 p-3 text-center">
                    <p class="display text-lg text-warm-50">{m.bathrooms}</p>
                    <p class="text-[9px] uppercase tracking-[0.18em] text-mist-400">baños</p>
                  </div>
                </div>

                <p class="text-[13px] leading-relaxed text-mist-300">{m.shortDescription}</p>
              </div>

              <div class="space-y-5">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-gold-400">Ambientes</p>
                  <ul class="mt-3 space-y-2">
                    {m.features.slice(0, 4).map((f) => (
                      <li class="flex items-start gap-2 text-[13px] text-warm-100">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" aria-hidden="true" />
                        {f}
                      </li>
                    ))}
                  </ul>
                </div>

                {m.floorPlans[0] && (
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-gold-400">Planta</p>
                    <button
                      type="button"
                      data-qv-plan={m.slug}
                      class="group mt-3 block w-full overflow-hidden border border-warm-50/12 bg-navy-900 p-2 text-left transition-colors hover:border-gold-500/50"
                    >
                      <span class="block overflow-hidden">
                        <MediaImage src={m.floorPlans[0]} alt={`Plano ${m.name}`} class="w-full" />
                      </span>
                      <span class="mt-2 flex items-center justify-between px-1 text-[11px] font-bold uppercase tracking-[0.18em] text-gold-400">
                        Ver plano ampliado
                        <Icon name="zoom" class="h-4 w-4" />
                      </span>
                    </button>
                  </div>
                )}

                <div class="flex flex-col gap-3 pt-1">
                  <a
                    href={wa ?? '#promo-form'}
                    target={wa ? '_blank' : undefined}
                    rel={wa ? 'noopener noreferrer' : undefined}
                    data-qv-wa
                    class="btn btn-gold w-full"
                  >
                    <Icon name={wa ? 'whatsapp' : 'mail'} class="h-4 w-4" />
                    Consultar por WhatsApp
                  </a>
                  <a href={`/viviendas-modulares/${m.slug}`} class="btn btn-ghost w-full">
                    Ver ficha completa
                    <Icon name="arrow-up-right" class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</div>

<script>
  import { trackEvent } from '../../lib/analytics/track';

  const modal = document.querySelector<HTMLElement>('[data-quickview]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-quickview-close]');
  const nameEl = document.querySelector<HTMLElement>('[data-qv-name]');
  const lineEl = document.querySelector<HTMLElement>('[data-qv-line]');
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-qv-panel]'));
  const LINES: Record<string, string> = {
    'homero-a00': 'Serie Austral · 18 m²',
    'homero-a01': 'Serie Austral · 21 m²',
    'austral-a00': 'Serie Austral · 25 m²',
    'nexa-austral-a00': 'Serie Austral · 35 m²',
    'beagle-d01': 'Serie Beagle · 45 m²',
  };

  if (!modal || !closeBtn || !nameEl || !lineEl) {
    throw new Error('ModelQuickView: marcado incompleto');
  }

  let lastFocus: HTMLElement | null = null;
  let currentSlug = '';

  function setModalOpen(open: boolean): void {
    modal!.classList.toggle('hidden', !open);
    modal!.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('overflow-hidden', open);
    window.dispatchEvent(new CustomEvent('morcat:modal', { detail: { open } }));
    if (open) {
      lastFocus = document.activeElement as HTMLElement | null;
      closeBtn!.focus();
    } else {
      lastFocus?.focus();
    }
  }

  function openModel(slug: string): void {
    const panel = panels.find((p) => p.dataset.qvPanel === slug);
    if (!panel) return;
    currentSlug = slug;
    panels.forEach((p) => {
      const active = p === panel;
      p.classList.toggle('hidden', !active);
      p.setAttribute('aria-hidden', String(!active));
    });
    nameEl!.textContent = slug.toUpperCase().replace(/-/g, ' ');
    lineEl!.textContent = LINES[slug] ?? '';
    setModalOpen(true);
    trackEvent('model_open', { model: slug });
  }

  // Apertura desde cualquier botón [data-quickview-open]
  document.querySelectorAll<HTMLElement>('[data-quickview-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.quickviewOpen;
      if (slug) openModel(slug);
    });
  });

  closeBtn.addEventListener('click', () => setModalOpen(false));
  modal.querySelector('[data-quickview-backdrop]')?.addEventListener('click', () => setModalOpen(false));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) setModalOpen(false);
  });

  // Eventos internos del modal
  modal.querySelector('[data-quickview-panels]')?.addEventListener('click', (e) => {
    const wa = (e.target as HTMLElement).closest('[data-qv-wa]');
    if (wa) trackEvent('model_whatsapp_click', { model: currentSlug });

    const planBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-qv-plan]');
    if (planBtn) {
      const slug = planBtn.dataset.qvPlan ?? currentSlug;
      window.dispatchEvent(new CustomEvent('morcat:floorplan-open', { detail: { slug } }));
    }
  });
</script>
