---
/**
 * MORCAT — Header reducido de landing de campaña.
 * Solo logo + WhatsApp. Fondo azul marino fijo (igual que el navbar
 * del sitio principal). Sin navegación corporativa (cero puntos de fuga).
 */
import Logo from '../Logo.astro';
import Icon from '../Icon.astro';
import { promoWhatsAppLink } from '../../lib/promo/whatsapp';

const wa = promoWhatsAppLink('hero');
---

<header
  class="promo-header fixed inset-x-0 top-0 z-50 h-[72px] border-b border-transparent bg-navy-950 transition-colors duration-300 sm:h-20"
  data-promo-header
>
  <div class="wrap flex h-full items-center justify-between">
    <Logo />

    <a
      href={wa ?? '#promo-form'}
      target={wa ? '_blank' : undefined}
      rel={wa ? 'noopener noreferrer' : undefined}
      data-track="hero_whatsapp_click"
      class="btn btn-gold !min-h-0 !px-4 !py-2.5 !text-[11px]"
    >
      <Icon name={wa ? 'whatsapp' : 'mail'} class="h-4 w-4" />
      {wa ? 'WhatsApp' : 'Escribinos'}
    </a>
  </div>
</header>

<script>
  import { trackEvent } from '../../lib/analytics/track';

  // Borde + sombra al hacer scroll (el fondo navy es fijo, no cambia)
  const header = document.querySelector<HTMLElement>('[data-promo-header]');
  const onScroll = () => {
    const solid = window.scrollY > 40;
    if (header) {
      header.style.borderColor = solid ? 'rgb(244 242 236 / 0.08)' : 'transparent';
      header.style.boxShadow = solid ? '0 10px 40px -18px rgb(0 0 0 / 0.6)' : 'none';
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Evento de clic en WhatsApp del header
  document.querySelector('[data-promo-header] a[data-track]')?.addEventListener('click', () => {
    trackEvent('hero_whatsapp_click', { placement: 'header' });
  });
</script>
