---
/**
 * MORCAT — Proceso de la landing (claro).
 * "DE LA CONSULTA AL PROYECTO." 6 pasos, sin plazos prometidos.
 */
import Icon from '../Icon.astro';
import type { Promo } from '../../data/promos';

interface Props {
  process: Promo['process'];
}

const { process } = Astro.props;
---

<section class="relative bg-warm-100 py-24 text-navy-950 sm:py-32" aria-labelledby="proceso-title">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <div class="eyebrow">
        <span>{process.eyebrow}</span>
      </div>
      <h2 id="proceso-title" class="display mt-5 text-4xl text-navy-950 sm:text-5xl">
        {process.title}
        <span class="block"><span class="serif-accent text-gold-700">{process.accentLine}</span></span>
      </h2>
    </div>

    <ol class="mt-14 grid gap-px border border-navy-950/10 bg-navy-950/10 sm:grid-cols-2 lg:grid-cols-3">
      {process.steps.map((step, i) => (
        <li class="bg-warm-100 p-7" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <span class="font-mono text-[13px] font-bold text-gold-700">{step.index}</span>
          <h3 class="display mt-4 text-lg text-navy-950">{step.title}</h3>
          <p class="mt-3 text-[13px] leading-relaxed text-navy-700/75">{step.description}</p>
        </li>
      ))}
    </ol>

    <p class="mt-6 flex items-start gap-2 text-[12px] text-navy-700/60" data-reveal="fade">
      <Icon name="info" class="mt-0.5 h-4 w-4 shrink-0" />
      {process.note}
    </p>
  </div>
</section>
