---
/**
 * MORCAT — Personalización (oscuro).
 * "UN MODELO NO TIENE QUE SER UNA LIMITACIÓN."
 * Categorías marcadas como SUJETO A PROYECTO (sin afirmar que
 * todo es modificable).
 */
import Icon from '../Icon.astro';
import type { Promo } from '../../data/promos';

interface Props {
  personalization: Promo['personalization'];
}

const { personalization } = Astro.props;
---

<section class="relative bg-navy-900 py-24 sm:py-32" aria-labelledby="personalizacion-title">
  <div class="grid-lines absolute inset-0 opacity-60" aria-hidden="true" />

  <div class="wrap relative grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div data-reveal>
      <div class="eyebrow">
        <span>{personalization.eyebrow}</span>
      </div>
      <h2 id="personalizacion-title" class="display mt-5 text-4xl text-warm-50 sm:text-5xl">
        {personalization.title}
        <span class="block"><span class="serif-accent text-gold-500">{personalization.accentLine}</span></span>
      </h2>
      <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-mist-300 sm:text-base">
        {personalization.copy}
      </p>
      <p class="mt-5 flex items-start gap-2 text-[13px] leading-relaxed text-mist-500">
        <Icon name="info" class="mt-0.5 h-4 w-4 shrink-0" />
        {personalization.note}
      </p>
    </div>

    <div class="grid gap-px border border-warm-50/10 bg-warm-50/10 sm:grid-cols-2" data-reveal="right">
      {personalization.categories.map((cat, i) => (
        <div class="flex flex-col justify-between bg-navy-800/70 p-7" style={`--reveal-delay: ${i * 70}ms`}>
          <span class="font-mono text-[12px] font-bold text-gold-500">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="mt-10">
            <h3 class="display text-xl text-warm-50">{cat}</h3>
            <p class="mt-3 inline-flex items-center gap-2 border border-gold-500/40 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-gold-400">
              <span class="h-1 w-1 rounded-full bg-gold-500" aria-hidden="true" />
              Sujeto a proyecto
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
