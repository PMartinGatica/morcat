---
/**
 * MORCAT — Menú mobile fullscreen.
 * Overlay completo con vínculos grandes, datos de contacto e
 * Instagram. El toggle y el comportamiento viven en Navbar.
 */
import { SITE } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<div
  id="mobile-menu"
  data-mobile-menu
  class="mobile-menu fixed inset-0 z-40 flex flex-col bg-navy-950 lg:hidden"
  aria-hidden="true"
>
  <div class="grid-lines absolute inset-0" aria-hidden="true" />

  <nav class="wrap relative flex flex-1 flex-col justify-center gap-1 pt-20" aria-label="Menú móvil">
    {items.map((item, i) => (
      <a
        href={item.href}
        class="menu-link group flex items-baseline gap-4 border-b border-warm-50/10 py-4"
        style={`transition-delay: ${i * 60}ms`}
      >
        <span class="text-[11px] font-semibold tracking-[0.2em] text-gold-500">
          0{i + 1}
        </span>
        <span class="display text-3xl text-warm-50 transition-colors duration-300 group-hover:text-gold-400 sm:text-4xl">
          {item.label}
        </span>
        <Icon name="arrow-up-right" class="ml-auto h-5 w-5 text-gold-500/70" />
      </a>
    ))}

    <a href="/contacto" class="btn btn-gold mt-8 self-start" data-menu-link>
      Cotizar proyecto
    </a>
  </nav>

  <div class="wrap relative border-t border-warm-50/10 py-6">
    <p class="text-[12px] uppercase tracking-[0.2em] text-mist-400">
      {SITE.address} · {SITE.city}
    </p>
    <div class="mt-3 flex items-center gap-5">
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[13px] font-medium text-warm-50 transition-colors hover:text-gold-400"
      >
        <Icon name="instagram" class="h-4 w-4" />
        {SITE.instagramHandle}
      </a>
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 text-[13px] font-medium text-warm-50 transition-colors hover:text-gold-400"
      >
        <Icon name="mail" class="h-4 w-4" />
        Contacto
      </a>
    </div>
  </div>
</div>
