---
/**
 * MORCAT — Formulario de contacto / consulta.
 *
 * El envío se resuelve en src/lib/forms/submit.ts:
 * endpoint propio (n8n / CRM / API) → si no hay, email sin backend
 * → si falla, mailto con la consulta redactada.
 *
 * Mejora progresiva: el HTML funciona aunque el script no cargue.
 */
import { FORMS } from '../config/forms';
import { SITE, whatsappLink } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  /** Origen de la consulta (home, modelo, promo, contacto…). */
  source?: string;
  submitLabel?: string;
  /** Compacto (para landings de campaña). */
  compact?: boolean;
  /** Mensaje de la ficha. */
  title?: string;
  subtitle?: string;
  id?: string;
}

const {
  source = 'web',
  submitLabel = 'ENVIAR CONSULTA',
  compact = false,
  title = 'ENVIANOS TU CONSULTA',
  subtitle = 'Completá el formulario y te respondemos a la brevedad.',
  id = 'contacto',
} = Astro.props;

const wa = whatsappLink('Hola MORCAT, quiero información sobre un proyecto.');
---

<section id={id} class="relative">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
    <!-- Columna informativa -->
    <div class="order-2 lg:order-1">
      <div data-reveal>
        <div class="eyebrow">
          <span>Contacto directo</span>
        </div>
        <h3 class="display mt-4 text-2xl text-warm-50 sm:text-3xl">Opciones <span class="serif-accent text-gold-500">directas</span></h3>
      </div>

      <ul class="mt-8 space-y-4" data-reveal>
        {wa && (
          <li>
            <a
              href={wa}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 border border-warm-50/12 bg-navy-800/50 p-5 transition-colors duration-300 hover:border-gold-500/60"
            >
              <Icon name="whatsapp" class="h-6 w-6 shrink-0 text-gold-500" />
              <span>
                <span class="block text-[11px] uppercase tracking-[0.2em] text-mist-400">WhatsApp</span>
                <span class="text-[15px] font-semibold text-warm-50 group-hover:text-gold-300">
                  Escribinos directo
                </span>
              </span>
              <Icon name="arrow-up-right" class="ml-auto h-5 w-5 text-gold-500/60" />
            </a>
          </li>
        )}
        <li>
          <a
            href={`mailto:${SITE.email}`}
            class="group flex items-center gap-4 border border-warm-50/12 bg-navy-800/50 p-5 transition-colors duration-300 hover:border-gold-500/60"
          >
            <Icon name="mail" class="h-6 w-6 shrink-0 text-gold-500" />
            <span>
              <span class="block text-[11px] uppercase tracking-[0.2em] text-mist-400">Email</span>
              <span class="text-[15px] font-semibold text-warm-50 group-hover:text-gold-300">
                {SITE.email}
              </span>
            </span>
            <Icon name="arrow-up-right" class="ml-auto h-5 w-5 text-gold-500/60" />
          </a>
        </li>
        <li>
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 border border-warm-50/12 bg-navy-800/50 p-5 transition-colors duration-300 hover:border-gold-500/60"
          >
            <Icon name="instagram" class="h-6 w-6 shrink-0 text-gold-500" />
            <span>
              <span class="block text-[11px] uppercase tracking-[0.2em] text-mist-400">Instagram</span>
              <span class="text-[15px] font-semibold text-warm-50 group-hover:text-gold-300">
                {SITE.instagramHandle}
              </span>
            </span>
            <Icon name="arrow-up-right" class="ml-auto h-5 w-5 text-gold-500/60" />
          </a>
        </li>
        <li class="flex items-start gap-4 border border-warm-50/12 bg-navy-800/50 p-5">
          <Icon name="map-pin" class="h-6 w-6 shrink-0 text-gold-500" />
          <span>
            <span class="block text-[11px] uppercase tracking-[0.2em] text-mist-400">Oficina</span>
            <span class="text-[15px] font-semibold text-warm-50">
              {SITE.address} · {SITE.city}
            </span>
            <span class="mt-1 block text-[13px] text-mist-400">
              Lun a Vie · {SITE.openingHours}
              <br />
              Sáb · {SITE.openingHoursSaturday}
            </span>
          </span>
        </li>
      </ul>
    </div>

    <!-- Formulario -->
    <div class="order-1 lg:order-2" data-reveal>
      <form
        class="border border-warm-50/12 bg-navy-900/70 p-6 backdrop-blur-sm sm:p-8"
        data-contact-form
        data-source={source}
        novalidate
      >
        <h3 class="display text-xl text-warm-50 sm:text-2xl">{title}</h3>
        <p class="mt-2 text-[14px] text-mist-400">{subtitle}</p>

        <div class="mt-7 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="cf-nombre" class="field-label">Nombre *</label>
            <input
              id="cf-nombre"
              name="nombre"
              type="text"
              autocomplete="given-name"
              required
              class="field"
              placeholder="Tu nombre"
            />
            <span class="field-error" data-error-for="nombre" hidden></span>
          </div>
          <div>
            <label for="cf-apellido" class="field-label">Apellido *</label>
            <input
              id="cf-apellido"
              name="apellido"
              type="text"
              autocomplete="family-name"
              required
              class="field"
              placeholder="Tu apellido"
            />
            <span class="field-error" data-error-for="apellido" hidden></span>
          </div>
          <div>
            <label for="cf-telefono" class="field-label">Teléfono</label>
            <input
              id="cf-telefono"
              name="telefono"
              type="tel"
              autocomplete="tel"
              class="field"
              placeholder="+54 9 ..."
            />
          </div>
          <div>
            <label for="cf-email" class="field-label">Email *</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="field"
              placeholder="tucorreo@ejemplo.com"
            />
            <span class="field-error" data-error-for="email" hidden></span>
          </div>
          <div class="sm:col-span-2">
            <label for="cf-tipo" class="field-label">Tipo de proyecto</label>
            <select id="cf-tipo" name="tipoProyecto" class="field appearance-none">
              {FORMS.projectTypes.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="cf-mensaje" class="field-label">Mensaje *</label>
            <textarea
              id="cf-mensaje"
              name="mensaje"
              rows={compact ? 4 : 5}
              required
              class="field resize-y"
              placeholder="Contanos qué querés construir, en qué terreno y cualquier detalle que sume."
            ></textarea>
            <span class="field-error" data-error-for="mensaje" hidden></span>
          </div>
        </div>

        <!-- Honeypot anti-spam -->
        <div class="hidden" aria-hidden="true">
          <label for="cf-web">No completar</label>
          <input id="cf-web" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
          <button type="submit" class="btn btn-gold" data-form-submit>
            <span data-submit-label>{submitLabel}</span>
            <span data-spinner class="hidden" aria-hidden="true">
              <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="3" />
                <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
            <Icon name="arrow-right" class="h-4 w-4" data-submit-arrow />
          </button>
          <p class="text-[12px] leading-relaxed text-mist-500">
            Tu consulta llega directo a nuestro email. Respondemos en horario de oficina.
          </p>
        </div>

        <!-- Estado -->
        <p class="mt-5 border border-gold-500/40 bg-gold-500/10 p-4 text-[14px] text-warm-50" data-form-success role="status" hidden></p>
        <div class="mt-5 border border-red-400/40 bg-red-400/10 p-4" data-form-error role="alert" hidden>
          <p class="text-[14px] text-warm-50" data-form-error-text></p>
          <a class="mt-3 inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.16em] text-gold-300 underline" data-form-mailto href={`mailto:${SITE.email}`}>
            Enviar por email
          </a>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { submitLead, buildMailto, successMessage } from '../lib/forms/submit';
  import { FORMS } from '../config/forms';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (!form) throw new Error('ContactForm: formulario no encontrado');

  const fields: Record<string, HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement> = {
    nombre: form.querySelector('#cf-nombre')!,
    apellido: form.querySelector('#cf-apellido')!,
    email: form.querySelector('#cf-email')!,
    mensaje: form.querySelector('#cf-mensaje')!,
  };

  const submitBtn = form.querySelector<HTMLButtonElement>('[data-form-submit]')!;
  const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
  const spinner = form.querySelector<HTMLElement>('[data-spinner]')!;
  const arrow = form.querySelector<HTMLElement>('[data-submit-arrow]')!;
  const successBox = form.querySelector<HTMLElement>('[data-form-success]')!;
  const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
  const errorText = form.querySelector<HTMLElement>('[data-form-error-text]')!;
  const mailtoLink = form.querySelector<HTMLAnchorElement>('[data-form-mailto]')!;

  function setError(name: string, message: string | null): void {
    const field = fields[name];
    const box = form!.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;
    if (!field) return;
    if (message) {
      box.textContent = message;
      box.hidden = false;
      field.setAttribute('aria-invalid', 'true');
      field.classList.add('border-red-400/70');
    } else {
      box.textContent = '';
      box.hidden = true;
      field.removeAttribute('aria-invalid');
      field.classList.remove('border-red-400/70');
    }
  }

  function validate(): boolean {
    let ok = true;
    const value = (name: string) => (fields[name]?.value ?? '').trim();
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!value('nombre')) { setError('nombre', 'Ingresá tu nombre.'); ok = false; }
    else setError('nombre', null);
    if (!value('apellido')) { setError('apellido', 'Ingresá tu apellido.'); ok = false; }
    else setError('apellido', null);
    if (!value('email')) { setError('email', 'Ingresá tu email.'); ok = false; }
    else if (!emailRe.test(value('email'))) { setError('email', 'El email no parece válido.'); ok = false; }
    else setError('email', null);
    if (!value('mensaje')) { setError('mensaje', 'Contanos brevemente tu proyecto.'); ok = false; }
    else setError('mensaje', null);

    return ok;
  }

  function setLoading(loading: boolean): void {
    submitBtn.disabled = loading;
    submitLabel.textContent = loading ? 'ENVIANDO…' : submitLabel.dataset.original ?? submitLabel.textContent ?? 'ENVIAR CONSULTA';
    spinner.classList.toggle('hidden', !loading);
    arrow.classList.toggle('hidden', loading);
  }

  // Guarda la etiqueta original del botón
  submitLabel.dataset.original = submitLabel.textContent ?? 'ENVIAR CONSULTA';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    successBox.hidden = true;
    errorBox.hidden = true;

    // Honeypot: si se completó, fingimos éxito sin enviar.
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    if (honeypot?.value) {
      successBox.textContent = successMessage('email');
      successBox.hidden = false;
      form.reset();
      return;
    }

    if (!validate()) return;

    const payload = {
      name: fields.nombre.value.trim(),
      lastname: fields.apellido.value.trim(),
      phone: (form.querySelector('#cf-telefono') as HTMLInputElement).value.trim(),
      email: fields.email.value.trim(),
      projectType: (form.querySelector('#cf-tipo') as HTMLSelectElement).value,
      message: fields.mensaje.value.trim(),
      source: form.dataset.source ?? 'web',
      landing_url: window.location.pathname,
      timestamp: new Date().toISOString(),
    };

    setLoading(true);
    const result = await submitLead(payload);
    setLoading(false);

    if (result.ok) {
      successBox.textContent = successMessage(result.channel);
      successBox.hidden = false;
      form.reset();
      return;
    }

    // Fallback: ofrecer el envío manual por email con la consulta ya redactada
    errorText.textContent = FORMS.errorMessage;
    mailtoLink.href = buildMailto(payload);
    errorBox.hidden = false;
  });
</script>
