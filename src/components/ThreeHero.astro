---
/**
 * MORCAT — Hero 3D (Three.js).
 *
 * Experiencia conceptual de arquitectura: una vivienda que se
 * "construye" progresivamente (puntos → planta → paredes →
 * cubierta → aberturas → volumen). La escena está desacoplada
 * en src/lib/three/ y se carga de forma diferida.
 *
 * Fallback: si no hay WebGL, si el dispositivo es muy limitado
 * o si hay prefers-reduced-motion, se muestra un póster estático
 * (wireframe) — la escena nunca bloquea el contenido.
 */
import ArchIllustration from './illustrations/ArchIllustration.astro';

const posterLabel = 'Póster estático de vivienda modular en wireframe';
---

<div
  class="three-hero absolute inset-0 overflow-hidden"
  data-three-hero
  aria-hidden="true"
>
  <!-- Póster de respaldo (visible hasta que arranca la escena) -->
  <div class="absolute inset-0 transition-opacity duration-1000" data-hero-poster>
    <ArchIllustration variant="wire" alt={posterLabel} class="h-full w-full" />
  </div>

  <!-- Canvas de la escena -->
  <canvas
    data-hero-canvas
    class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"
  ></canvas>

  <!-- Cobertura degradada para legibilidad del texto -->
  <div class="absolute inset-0 bg-gradient-to-r from-navy-950/85 via-navy-950/30 to-navy-950/20" />
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-navy-950 to-transparent" />

  <!-- Pie de escena -->
  <div class="absolute bottom-5 left-5 z-10 hidden items-center gap-2 sm:flex">
    <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-gold-500" />
    <span class="text-[10px] font-semibold uppercase tracking-[0.24em] text-mist-400">
      Escena conceptual · vivienda modular en construcción
    </span>
  </div>
</div>

<script>
  /**
   * Carga diferida: primero se evalúa el fallback (sin traer
   * three.js); solo si hace falta se importa la escena.
   */
  async function boot(): Promise<void> {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (!canvas) return;

    const { shouldUseStaticFallback } = await import('../lib/three/performance');
    if (shouldUseStaticFallback()) return; // póster estático

    const { createArchitectureScene } = await import('../lib/three/architectureScene');
    const handle = createArchitectureScene({ canvas, quality: 'auto' });
    if (!handle.isSupported) return;

    handle.start();

    // Fade-in del canvas sobre el póster
    canvas.style.opacity = '1';
    const poster = document.querySelector<HTMLElement>('[data-hero-poster]');
    if (poster) poster.style.opacity = '0';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
