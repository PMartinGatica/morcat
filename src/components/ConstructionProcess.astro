---
/**
 * MORCAT — Proceso de construcción (01 Idea → 05 Entrega).
 */
import type { ProcessStep } from '../data/construction';
import { CONSTRUCTION_PROCESS } from '../data/construction';

interface Props {
  steps?: ProcessStep[];
}

const steps = Astro.props.steps ?? CONSTRUCTION_PROCESS;
---

<ol class="relative grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
  <!-- línea conectora (desktop) -->
  <div
    class="absolute left-0 right-0 top-[22px] hidden h-px bg-gradient-to-r from-gold-500/50 via-gold-500/15 to-gold-500/50 lg:block"
    aria-hidden="true"
  />

  {steps.map((step, i) => (
    <li class="relative" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
      <div class="relative z-10 flex h-11 w-11 items-center justify-center border border-gold-500/50 bg-navy-900">
        <span class="font-mono text-[13px] font-bold text-gold-500">{step.index}</span>
      </div>
      <h3 class="display mt-5 text-xl text-warm-50">{step.title}</h3>
      <p class="mt-3 text-[13px] leading-relaxed text-mist-400 sm:text-[14px]">
        {step.description}
      </p>
    </li>
  ))}
</ol>
