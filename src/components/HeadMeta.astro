---
/**
 * MORCAT — Encabezado del documento (meta + SEO + structured data).
 * Se renderiza dentro de <head>. Toda la meta centralizada.
 */
import { SITE, absoluteUrl } from '../config/site';
import { organizationSchema, webSiteSchema, breadcrumbSchema, type Crumb } from '../lib/seo/structuredData';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica (default: pathname actual). */
  canonicalPath?: string;
  /** Imagen OG (path absoluto en public/). */
  ogImage?: string;
  noindex?: boolean;
  /** Migas de pan (BreadcrumbList). */
  breadcrumbs?: Crumb[];
  /** JSON-LD extra (objetos completos con @context). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/images/og-cover.svg',
  noindex = false,
  breadcrumbs,
  jsonLd = [],
} = Astro.props;

const canonical = absoluteUrl(canonicalPath);
const og = absoluteUrl(ogImage);
const titleFull = title.includes(SITE.legalName) ? title : `${title} — ${SITE.legalName}`;

const schemas: Record<string, unknown>[] = [...jsonLd];
if (breadcrumbs && breadcrumbs.length) schemas.push(breadcrumbSchema(breadcrumbs));
if (canonicalPath === '/' || canonicalPath === '') {
  schemas.unshift(organizationSchema());
  schemas.unshift(webSiteSchema());
}
---

<title>{titleFull}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta name="theme-color" content="#0B1629" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.legalName} />
<meta property="og:locale" content="es_AR" />
<meta property="og:title" content={titleFull} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titleFull} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />

<!-- Structured data -->
{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  ))
}
