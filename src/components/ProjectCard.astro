---
/**
 * MORCAT — Tarjeta de proyecto (portfolio).
 */
import type { Project } from '../data/projects';
import MediaImage from './MediaImage.astro';
import DemoBadge from './DemoBadge.astro';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  delay?: number;
  class?: string;
}

const { project, delay = 0, class: className = '' } = Astro.props;
---

<article class={`card group ${className}`} data-reveal style={`--reveal-delay: ${delay}ms`}>
  <a href={`/proyectos/${project.slug}`} class="block" aria-label={`Ver proyecto ${project.name}`}>
    <div class="card-media aspect-[16/11]">
      <MediaImage src={project.gallery[0] ?? 'front'} alt={`Proyecto ${project.name} — ${project.location}`} class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950/75 via-transparent to-transparent" aria-hidden="true" />

      <div class="absolute left-4 top-4 flex flex-wrap items-center gap-2">
        <DemoBadge demo={project.demo} />
      </div>

      <div class="absolute bottom-4 left-4 right-4">
        <h3 class="display text-2xl text-warm-50">{project.name}</h3>
      </div>
    </div>

    <div class="mt-4 flex items-center justify-between border-t border-warm-50/10 pt-4">
      <span class="text-[13px] text-mist-400">{project.type}</span>
      <span class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-gold-400 transition-colors group-hover:text-gold-300">
        Ver proyecto
        <Icon name="arrow-up-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </span>
    </div>
  </a>
</article>
