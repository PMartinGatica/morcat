---
/**
 * MORCAT — Ilustraciones arquitectónicas (line art) DEMO.
 *
 * Mientras no existan fotografías o renders reales, estas
 * ilustraciones vectoriales funcionan como imágenes de los
 * modelos, proyectos y secciones. Son placeholders claramente
 * identificados: cuando lleguen las imágenes reales, se
 * reemplaza la clave por una ruta '/images/...' en los datos.
 *
 * Variantes: front, side, duo, interior, night, construction,
 * ushuaia, wire.
 */
interface Props {
  variant: string;
  alt?: string;
  class?: string;
}

const { variant, alt = 'Ilustración arquitectónica de MORCAT', class: className = '' } =
  Astro.props;

const COMMON = {
  stroke: '#f4f2ec',
  gold: '#d39a29',
  dim: '#163450',
  line: 2,
};
---

{
  variant === 'front' && (
    <svg
      viewBox="0 0 800 500"
      class={className}
      role="img"
      aria-label={alt}
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <!-- cielo -->
      <g stroke="none">
        <rect x="0" y="0" width="800" height="410" fill="rgba(244,242,236,0.028)" />
      </g>
      <!-- piso / terreno -->
      <line x1="70" y1="412" x2="730" y2="412" stroke={COMMON.dim} stroke-width="1.5" />
      <line x1="70" y1="452" x2="730" y2="452" stroke={COMMON.dim} stroke-width="1" stroke-opacity="0.6" />
      <!-- pino izquierdo -->
      <g stroke={COMMON.dim} stroke-width="2">
        <path d="M118 380 L94 318 L106 318 L84 262 L98 262 L72 196 L126 196 L100 262 L114 262 L92 318 L104 318 Z" fill="rgba(22,52,80,0.25)" />
        <line x1="96" y1="412" x2="96" y2="380" />
      </g>
      <!-- pino derecho -->
      <g stroke={COMMON.dim} stroke-width="2">
        <path d="M688 380 L664 316 L676 316 L654 258 L668 258 L642 192 L698 192 L672 258 L686 258 L664 316 L676 316 Z" fill="rgba(22,52,80,0.25)" />
        <line x1="668" y1="412" x2="668" y2="380" />
      </g>
      <!-- zócalo / plinto -->
      <rect x="158" y="380" width="484" height="32" stroke={COMMON.stroke} stroke-opacity="0.55" stroke-width="1.5" fill="rgba(244,242,236,0.04)" />
      <!-- muros -->
      <rect x="180" y="208" width="440" height="172" stroke={COMMON.stroke} stroke-opacity="0.88" stroke-width="2.2" fill="rgba(244,242,236,0.05)" />
      <!-- cubierta a dos aguas -->
      <path d="M158 212 L400 124 L642 212" stroke={COMMON.stroke} stroke-width="2.6" />
      <line x1="400" y1="124" x2="400" y2="208" stroke={COMMON.stroke} stroke-opacity="0.4" stroke-width="1.5" />
      <!-- línea de alero dorada -->
      <line x1="186" y1="212" x2="614" y2="212" stroke={COMMON.gold} stroke-width="1.4" stroke-opacity="0.7" />
      <!-- aberturas doradas: puerta -->
      <g stroke={COMMON.gold} stroke-width="2">
        <rect x="356" y="272" width="88" height="108" />
        <circle cx="428" cy="328" r="3" fill={COMMON.gold} stroke="none" />
      </g>
      <!-- ventanas -->
      <g stroke={COMMON.gold} stroke-width="1.8">
        <rect x="212" y="246" width="92" height="70" />
        <line x1="258" y1="246" x2="258" y2="316" />
        <line x1="212" y1="281" x2="304" y2="281" />
        <rect x="496" y="246" width="92" height="70" />
        <line x1="542" y1="246" x2="542" y2="316" />
        <line x1="496" y1="281" x2="588" y2="281" />
      </g>
      <!-- detalles de panel (juntas) -->
      <g stroke={COMMON.stroke} stroke-opacity="0.22" stroke-width="1">
        <line x1="180" y1="296" x2="620" y2="296" />
        <line x1="260" y1="208" x2="260" y2="380" />
        <line x1="420" y1="208" x2="420" y2="272" />
        <line x1="540" y1="208" x2="540" y2="380" />
      </g>
      <!-- suelo: líneas de apoyo -->
      <g stroke={COMMON.stroke} stroke-opacity="0.35" stroke-width="1.2">
        <line x1="200" y1="412" x2="200" y2="440" />
        <line x1="300" y1="412" x2="300" y2="440" />
        <line x1="400" y1="412" x2="400" y2="440" />
        <line x1="500" y1="412" x2="500" y2="440" />
        <line x1="600" y1="412" x2="600" y2="440" />
      </g>
    </svg>
  )
}

