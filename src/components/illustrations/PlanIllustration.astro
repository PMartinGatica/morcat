    windows: [
      [90, 80, 180, 80],
      [400, 80, 480, 80],
      [570, 80, 650, 80],
      [230, 430, 340, 430],
      [600, 230, 660, 230],
    ],
    note: '3 dormitorios + 2 baños',
  },
};

const plan = PLANS[variant];

const STROKE = '#f4f2ec';
const GOLD = '#d39a29';

function doorArc(d: PlanDoor): string {
  const { x, y, r } = d;
  switch (d.dir) {
    case 'up':
      return `M ${x} ${y} A ${r} ${r} 0 0 1 ${x - r} ${y - r}`;
    case 'down':
      return `M ${x} ${y} A ${r} ${r} 0 0 1 ${x + r} ${y + r}`;
    case 'left':
      return `M ${x} ${y} A ${r} ${r} 0 0 1 ${x - r} ${y - r}`;
    case 'right':
      return `M ${x} ${y} A ${r} ${r} 0 0 0 ${x + r} ${y - r}`;
  }
}
---

{
  plan && (
    <svg
      viewBox="0 0 710 470"
      class={className}
      role="img"
      aria-label={alt}
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="0" y="0" width="710" height="470" fill="rgba(244,242,236,0.025)" />

      <!-- habitaciones -->
      {plan.rooms.map((r) => (
        <g>
          <rect x={r.x} y={r.y} width={r.w} height={r.h} stroke={STROKE} stroke-opacity="0.3" stroke-width="1.2" fill="rgba(244,242,236,0.03)" />
          <text
            x={r.x + r.w / 2}
            y={r.y + r.h / 2}
            text-anchor="middle"
            fill={STROKE}
            fill-opacity="0.75"
            font-family="'Archivo Variable', sans-serif"
            font-size="15"
            font-weight="600"
            letter-spacing="3"
          >
            {r.label}
          </text>
        </g>
      ))}

      <!-- muro exterior -->
      <rect x="40" y="80" width={plan.w} height={plan.h} stroke={STROKE} stroke-opacity="0.95" stroke-width="2.6" />

      <!-- tabiques -->
      {plan.partitions.map(([x1, y1, x2, y2]) => (
        <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={STROKE} stroke-opacity="0.7" stroke-width="1.8" />
      ))}

      <!-- puertas -->
      {plan.doors.map((d) => (
        <g stroke={GOLD} stroke-width="1.6">
          <path d={doorArc(d)} stroke-opacity="0.9" />
          <line x1={d.x} y1={d.y} x2={d.x} y2={d.y} stroke-width="4" stroke-linecap="butt" />
        </g>
      ))}

      <!-- ventanas (doble trazo sobre el muro) -->
      {plan.windows.map(([x1, y1, x2, y2]) => (
        <g stroke={GOLD} stroke-width="2">
          <line x1={x1} y1={y1} x2={x2} y2={y2} />
          <line x1={x1} y1={y1 - 7} x2={x2} y2={y2 - 7} stroke-opacity="0.45" />
        </g>
      ))}

      <!-- cota de ancho -->
      <g stroke={STROKE} stroke-opacity="0.45" stroke-width="1.2">
        <line x1="40" y1="58" x2={40 + plan.w} y2="58" />
        <path d={`M 40 62 L 40 54 M ${40 + plan.w} 62 L ${40 + plan.w} 54`} />
      </g>
      <text
        x={40 + plan.w / 2}
        y="48"
        text-anchor="middle"
        fill={STROKE}
        fill-opacity="0.6"
        font-family="'Archivo Variable', sans-serif"
        font-size="14"
        letter-spacing="3"
      >
        {(plan.w / 70).toFixed(1).replace('.', ',')} m
      </text>

      <!-- cota lateral -->
      <g stroke={STROKE} stroke-opacity="0.45" stroke-width="1.2">
        <line x1={40 + plan.w + 26} y1="80" x2={40 + plan.w + 26} y2={80 + plan.h} />
        <path d={`M ${40 + plan.w + 22} 80 L ${40 + plan.w + 30} 80 M ${40 + plan.w + 22} ${80 + plan.h} L ${40 + plan.w + 30} ${80 + plan.h}`} />
      </g>
      <text
        x={40 + plan.w + 38}
        y={80 + plan.h / 2}
        text-anchor="middle"
        transform={`rotate(90 ${40 + plan.w + 38} ${80 + plan.h / 2})`}
        fill={STROKE}
        fill-opacity="0.6"
        font-family="'Archivo Variable', sans-serif"
        font-size="14"
        letter-spacing="3"
      >
        {(plan.h / 70).toFixed(1).replace('.', ',')} m
      </text>

      <!-- superficie -->
      <g>
        <text
          x="40"
          y="440"
          fill={GOLD}
          font-family="'Archivo Variable', sans-serif"
          font-size="30"
          font-weight="800"
          letter-spacing="2"
        >
          {plan.surface} m²
        </text>
        <text
          x="40"
          y="462"
          fill={STROKE}
          fill-opacity="0.6"
          font-family="'Archivo Variable', sans-serif"
          font-size="13"
          letter-spacing="3"
        >
          {plan.note.toUpperCase()}
        </text>
      </g>

      <!-- marca demo -->
      {isDemoVisible() && (
        <text
          x="670"
          y="456"
          text-anchor="end"
          fill={GOLD}
          fill-opacity="0.8"
          font-family="'Archivo Variable', sans-serif"
          font-size="12"
          font-weight="700"
          letter-spacing="4"
        >
          PLANTA DEMO
        </text>
      )}

      <!-- norte -->
      <g stroke={GOLD} stroke-width="1.4">
        <circle cx="650" cy="110" r="20" stroke-opacity="0.5" />
        <path d="M650 132 L650 92 M644 100 L650 92 L656 100" fill={GOLD} fill-opacity="0.8" stroke="none" />
      </g>
    </svg>
  )
}
