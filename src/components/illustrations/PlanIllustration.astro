      { x: 290, y: 230, dir: 'down', r: 42 },
      { x: 350, y: 160, dir: 'left', r: 42 },
      { x: 530, y: 160, dir: 'left', r: 42 },
      { x: 620, y: 340, dir: 'up', r: 38 },
