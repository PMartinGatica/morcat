---
/**
 * MORCAT — Planos de planta (line art) DEMO.
 * Plantas esquemáticas provisorias por modelo. Cuando existan
 * planos reales, reemplazar las claves 'plan-*' por rutas en
 * src/data/homes.ts.
 */
import { isDemoVisible } from '../../lib/utils/demo';

interface PlanRoom {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
}

interface PlanDoor {
  x: number;
  y: number;
  /** orientación del arco: 'up' | 'down' | 'left' | 'right' */
  dir: 'up' | 'down' | 'left' | 'right';
  r: number;
}

interface PlanData {
  surface: number;
  w: number;
  h: number;
  rooms: PlanRoom[];
  partitions: [number, number, number, number][];
  doors: PlanDoor[];
  windows: [number, number, number, number][];
  note: string;
}

interface Props {
  variant: string;
  alt?: string;
  class?: string;
}

const { variant, alt = 'Plano de planta esquemático', class: className = '' } = Astro.props;

const PLANS: Record<string, PlanData> = {
  'plan-18': {
    surface: 18,
    w: 350,
    h: 252,
    rooms: [
      { x: 40, y: 80, w: 350, h: 252, label: 'ESTAR / DESCANSO' },
      { x: 296, y: 80, w: 94, h: 96, label: 'BAÑO' },
    ],
    partitions: [[296, 80, 296, 176]],
    doors: [{ x: 296, y: 150, dir: 'right', r: 38 }],
    windows: [
      [90, 80, 170, 80],
      [220, 80, 290, 80],
      [40, 250, 120, 250],
    ],
    note: 'Un ambiente integrado + baño completo',
  },
  'plan-21': {
    surface: 21,
    w: 420,
    h: 245,
    rooms: [
      { x: 40, y: 80, w: 200, h: 245, label: 'DORM.' },
      { x: 240, y: 80, w: 220, h: 245, label: 'ESTAR-COC.' },
      { x: 356, y: 80, w: 104, h: 102, label: 'BAÑO' },
    ],
    partitions: [
      [240, 80, 240, 325],
      [356, 80, 356, 182],
      [240, 182, 356, 182],
    ],
    doors: [
      { x: 240, y: 306, dir: 'right', r: 40 },
      { x: 356, y: 152, dir: 'down', r: 38 },
    ],
    windows: [
      [90, 80, 170, 80],
      [300, 80, 370, 80],
      [240, 325, 330, 325],
    ],
    note: 'Dormitorio + estar-cocina integrado',
  },
  'plan-25': {
    surface: 25,
    w: 455,
    h: 266,
    rooms: [
      { x: 40, y: 80, w: 200, h: 266, label: 'DORM. 1' },
      { x: 240, y: 220, w: 255, h: 126, label: 'ESTAR-COC.' },
      { x: 240, y: 80, w: 130, h: 140, label: 'BAÑO' },
      { x: 370, y: 80, w: 125, h: 140, label: 'DORM. 2' },
    ],
    partitions: [
      [240, 80, 240, 346],
      [240, 220, 495, 220],
      [370, 80, 370, 220],
    ],
    doors: [
      { x: 240, y: 320, dir: 'right', r: 40 },
      { x: 300, y: 220, dir: 'down', r: 38 },
      { x: 370, y: 160, dir: 'left', r: 38 },
    ],
    windows: [
      [90, 80, 180, 80],
      [430, 80, 480, 80],
      [240, 346, 330, 346],
      [430, 220, 490, 220],
    ],
    note: '2 dormitorios + baño',
  },
  'plan-35': {
    surface: 35,
    w: 560,
    h: 308,
    rooms: [
      { x: 40, y: 80, w: 190, h: 308, label: 'DORM. 1' },
      { x: 230, y: 200, w: 370, h: 188, label: 'ESTAR-COC.' },
      { x: 230, y: 80, w: 130, h: 120, label: 'BAÑO' },
      { x: 360, y: 80, w: 240, h: 120, label: 'DORM. 2' },
    ],
    partitions: [
      [230, 80, 230, 388],
      [230, 200, 600, 200],
      [360, 80, 360, 200],
    ],
    doors: [
      { x: 230, y: 360, dir: 'right', r: 42 },
      { x: 280, y: 200, dir: 'down', r: 40 },
      { x: 360, y: 150, dir: 'left', r: 40 },
    ],
    windows: [
      [90, 80, 180, 80],
      [410, 80, 500, 80],
      [560, 230, 600, 230],
      [230, 388, 330, 388],
    ],
    note: '2 dormitorios + estar-cocina amplio',
  },
  'plan-45': {
    surface: 45,
    w: 630,
    h: 350,
    rooms: [
      { x: 40, y: 80, w: 190, h: 350, label: 'DORM. 1' },
      { x: 230, y: 230, w: 440, h: 200, label: 'ESTAR-COC.' },
      { x: 230, y: 80, w: 120, h: 150, label: 'BAÑO 1' },
      { x: 350, y: 80, w: 180, h: 150, label: 'DORM. 2' },
