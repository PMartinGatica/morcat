---
/**
 * MORCAT — Logo.
 *
 * Isotipo real del cliente (sello circular navy/dorado con "MORCAT
 * CONSTRUCTORA SRL"). El archivo recibido (logomorcatv1.svg) es en
 * realidad un PNG de 1542x1542 envuelto en una etiqueta <svg> — no
 * es un vector editable. Se extrajo el PNG real a
 * src/assets/media/logo/morcat-badge.png para que astro:assets lo
 * optimice (AVIF/WebP + tamaños). Si más adelante el cliente provee
 * el archivo fuente (Illustrator/Figma/EPS), reemplazar por una
 * versión vectorial y, de ser posible, separar el isotipo del
 * wordmark para poder ajustarlos de forma independiente.
 */
import { Image } from 'astro:assets';
import { getMedia } from '../lib/media/manifest';

interface Props {
  class?: string;
  /** Solo el símbolo circular (navbar móvil, footers de promo, etc.). */
  markOnly?: boolean;
  /** Tamaño del símbolo (clases tailwind h-* w-*). */
  markClass?: string;
}

const { class: className = '', markOnly = false, markClass = 'h-[60px] w-[60px] sm:h-[66px] sm:w-[66px]' } =
  Astro.props;

const badge = getMedia('logo/morcat-badge');
---

<a href="/" class={`group inline-flex items-center gap-3 ${className}`} aria-label="MORCAT Constructora — Inicio">
  {badge && (
    <Image
      src={badge}
      alt="Morcat Constructora SRL"
      class={`${markClass} shrink-0 rounded-full object-contain`}
      widths={[64, 96, 128, 192]}
      sizes="96px"
      quality={92}
      loading="eager"
      decoding="async"
    />
  )}

  {!markOnly && (
    <span class="flex flex-col leading-none">
      <span class="font-display text-[17px] font-extrabold uppercase tracking-[0.22em] text-warm-50">
        Morcat
      </span>
      <span class="mt-1.5 text-[9px] font-semibold uppercase tracking-[0.34em] text-gold-500">
        Constructora SRL
      </span>
    </span>
  )}
</a>
